{
  "name": "node-js-express-application",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "start:dev": "nodemon ./src/server.ts",
    "start": "npm run build && ./node_modules/.bin/pm2 start ./dist/src/server.js --name node-js-express-application",
    "stop": "./node_modules/.bin/pm2 delete node-js-express-application",
    "build": "mkdir -p dist && cp package.json dist/ && tsc",
    "test": "jest",
    "test:module-6-express-app": "jest --testPathPattern=./src/test/module-6-express-app",
    "test:module-7-nosql": "jest --testPathPattern=./src/test/module-7-nosql",
    "test:module-8-relational-dbs": "jest --testPathPattern=./src/test/module-8-relational-dbs",
    "test:module-9-auth": "jest --testPathPattern=./src/test/module-9-auth",
    "test:module-10-production-ready-app": "jest --testPathPattern=./src/test/module-10-production-ready-app",
    "db:migrations:create": "npx mikro-orm migration:create",
    "pretest": "npm run db:migrations:create && ts-node src/scripts/setup-database.ts",
    "posttest": "npm stop",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mikro-orm/cli": "^6.6.8",
    "@mikro-orm/core": "^6.6.8",
    "@mikro-orm/migrations": "^6.6.8",
    "@mikro-orm/postgresql": "^6.6.8",
    "@mikro-orm/seeder": "^6.6.8",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.2.3",
    "pg": "^8.13.1",
    "winston": "^3.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mongoose": "^5.11.97",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.14",
    "pm2": "^6.0.14",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.7.3"
  }
}
